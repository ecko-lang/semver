# Version ranges: `^1.2.3`, `~1.2.3`, `>=1.2.3 <2.0.0`, `^1.0.0 || ^3.0.0`.
#
# The npm range grammar, because it is what people have in their fingers and
# what `ecko get pkg@^1.2.0` should mean. A range is an OR of alternatives
# split on `||`; each alternative is an AND of whitespace-separated
# comparators. Every version in a range is a full major.minor.patch: the
# partial forms (`~1.2`, `^1`, `1.x`) and hyphen ranges (`1.2.3 - 2.0.0`) are
# refused with `unsupported_range` rather than read as something else.

import "./parse.ecko"

MAX_FIELD = 9223372036854775807

# Operators that may stand apart from their version, as in `>= 1.2.3`.
OPERATORS = [">=", "<=", ">", "<", "=", "^", "~"]

## Expand a range into its alternatives, each a list of `{ op, version }`
## comparators, where `op` is one of ">=", ">", "<=", "<" or "=".
##
## `^` and `~` expand to a pair of bounds and `*` to `>=0.0.0`. This is the
## form `satisfies` evaluates, exposed for inspection.
##
## errors: `semver`/`bad_range` when the range or an alternative is empty or
## an operator has no version; `semver`/`unsupported_range` for a hyphen
## range or a partial or x-range version; `semver`/`bad_version` or
## `semver`/`out_of_range` when a version does not parse; `bug`/`bad_argument`
## when `text` is not a string.
##
## example:
##   semver.parse_range("^1.2.3")
##   # [[{op: >=, version: 1.2.3}, {op: <, version: 2.0.0}]]
export fn parse_range(text) {
    unless type_of(text) == "string" {
        parse.bad_argument("semver.parse_range: range must be a string, got {type_of(text)}")
    }
    trimmed = trim(text)
    if trimmed == "" { parse.fail("bad_range", "semver: a range must not be empty") }
    map(split(trimmed, "||"), fn(alt) comparators(trim(alt), text))
}

# One alternative: whitespace-separated terms, each expanded to comparators.
fn comparators(alt, text) {
    words = filter(split(alt, " "), fn(t) t != "")
    if len(words) == 0 {
        parse.fail("bad_range", "semver: range '{text}' has an empty alternative")
    }
    if "-" in words {
        parse.fail(
            "unsupported_range",
            "semver: hyphen ranges are not supported, got '{text}'; write '>=A <=B' instead",
        )
    }
    flatten(map(join_operators(words, text), fn(t) expand_term(t, text)))
}

# Glue a bare operator to the version after it, so `>= 1.2.3` reads as
# `>=1.2.3` rather than as an operator with an empty version.
fn join_operators(words, text) {
    mut terms = []
    mut pending = ""
    for w in words {
        if w in OPERATORS {
            unless pending == "" {
                parse.fail("bad_range", "semver: operator '{pending}' has no version in '{text}'")
            }
            pending = w
        } else {
            terms = push(terms, pending + w)
            pending = ""
        }
    }
    unless pending == "" {
        parse.fail("bad_range", "semver: operator '{pending}' has no version in '{text}'")
    }
    terms
}

# A single term to the comparators it stands for. `^` and `~` and `*` are
# shorthand for a pair of bounds; the explicit operators pass through.
fn expand_term(term, text) {
    if term == "*" { return [{ op: ">=", version: "0.0.0" }] }
    if starts_with(term, "^") { return caret(full(strip_op(term, 1), text)) }
    if starts_with(term, "~") { return tilde(full(strip_op(term, 1), text)) }
    for op in [">=", "<=", ">", "<", "="] {
        if starts_with(term, op) {
            return [{ op: op, version: full(strip_op(term, len(op)), text) }]
        }
    }
    [{ op: "=", version: full(term, text) }]
}

# Drop an `n`-character operator prefix.
fn strip_op(term, n) {
    trim(join(drop(chars(term), n), ""))
}

# A range's version, checked: a partial or x-range is refused as unsupported,
# and anything else must parse.
fn full(version, text) {
    core = first(split(first(split(version, "+")), "-"))
    fields = split(core, ".")
    wild = fn(f) f == "x" or f == "X" or f == "*"
    numeric = fn(f) f != "" and all(chars(f), fn(c) c >= "0" and c <= "9")
    looks_partial = all(fields, fn(f) wild(f) or numeric(f))
    if looks_partial and (len(fields) < 3 or any(fields, wild)) {
        parse.fail(
            "unsupported_range",
            "semver: partial and x-range versions are not supported, got '{version}' in '{text}'",
        )
    }
    _ = parse.parse(version)
    version
}

# n + 1 for an upper bound, or `out_of_range` past a 64-bit integer.
fn next(n, version) {
    if n == MAX_FIELD {
        parse.fail("out_of_range", "semver: the upper bound of '{version}' does not fit in 64 bits")
    }
    n + 1
}

# `^1.2.3` allows changes that do not modify the leftmost non-zero number, so
# the upper bound moves depending on where that digit is: ^1.2.3 stops at
# 2.0.0, ^0.2.3 at 0.3.0, ^0.0.3 at 0.0.4.
fn caret(text) {
    p = parse.parse(text)
    upper = if p.major > 0 {
        "{next(p.major, text)}.0.0"
    } else {
        if p.minor > 0 { "0.{next(p.minor, text)}.0" } else { "0.0.{next(p.patch, text)}" }
    }
    [{ op: ">=", version: text }, { op: "<", version: upper }]
}

# `~1.2.3` allows patch-level changes: at least 1.2.3, below 1.3.0.
fn tilde(text) {
    p = parse.parse(text)
    [{ op: ">=", version: text }, { op: "<", version: "{p.major}.{next(p.minor, text)}.0" }]
}

# Does one comparator hold for `version`?
fn matches_comparator(version, c) {
    order = parse.compare(version, c.version)
    if c.op == ">=" { return order >= 0 }
    if c.op == ">" { return order > 0 }
    if c.op == "<=" { return order <= 0 }
    if c.op == "<" { return order < 0 }
    order == 0
}

## Whether `version` falls inside `range`.
##
## A pre-release only ever matches a range that names a pre-release on the
## same major.minor.patch. Without that rule `^1.0.0` would quietly accept
## `2.0.0-alpha`, which is the behaviour every package ecosystem regrets.
##
## errors: as `parse_range` for the range; `semver`/`bad_version` when
## `version` does not parse; `bug`/`bad_argument` when either is not a string.
##
## example:
##   semver.satisfies("1.9.3", "^1.2.0")   # true
export fn satisfies(version, range) {
    unless type_of(version) == "string" {
        parse.bad_argument("semver.satisfies: version must be a string, got {type_of(version)}")
    }
    alternatives = parse_range(range)
    v = parse.parse(version)
    any(alternatives, fn(alt) alternative_holds(v, alt))
}

# Every comparator in an alternative must hold, plus the pre-release rule.
fn alternative_holds(v, alt) {
    unless all(alt, fn(c) matches_comparator(v, c)) { return false }
    if len(v.prerelease) == 0 { return true }
    any(alt, fn(c) mentions_same_prerelease(v, c))
}

# Does this comparator name a pre-release on the same core version?
fn mentions_same_prerelease(v, c) {
    other = parse.parse(c.version)
    if len(other.prerelease) == 0 { return false }
    other.major == v.major and other.minor == v.minor and other.patch == v.patch
}

# The valid versions in `versions` that satisfy `range`, in ascending order.
fn matching(versions, range, who) {
    unless type_of(versions) == "list" {
        parse.bad_argument("{who}: versions must be a list, got {type_of(versions)}")
    }
    alternatives = parse_range(range)
    ok = filter(versions, fn(x) {
        unless parse.valid(x) { return false }
        v = parse.parse(x)
        any(alternatives, fn(alt) alternative_holds(v, alt))
    })
    parse.sort(ok)
}

## The highest version in `versions` that satisfies `range`, or null.
##
## Entries that are not valid versions, such as a `latest` tag or a
## `v1.2.0` with its prefix, are skipped rather than raising.
##
## errors: as `parse_range` for the range; `bug`/`bad_argument` when
## `versions` is not a list.
##
## example:
##   semver.max_satisfying(["1.0.0", "1.4.2", "2.0.0", "latest"], "^1.0.0")   # 1.4.2
export fn max_satisfying(versions, range) {
    ok = matching(versions, range, "semver.max_satisfying")
    if len(ok) == 0 { return null }
    last(ok)
}

## The lowest version in `versions` that satisfies `range`, or null.
##
## Entries that are not valid versions are skipped, as in `max_satisfying`.
##
## errors: as `max_satisfying`.
##
## example:
##   semver.min_satisfying(["1.0.0", "1.4.2", "2.0.0"], "^1.1.0")   # 1.4.2
export fn min_satisfying(versions, range) {
    ok = matching(versions, range, "semver.min_satisfying")
    if len(ok) == 0 { return null }
    first(ok)
}
